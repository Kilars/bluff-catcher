[Unit]
Description=bluff-catcher: process three coaching videos, then autoreview them into the KB

[Service]
Type=oneshot
WorkingDirectory=/home/larsski/Code/bluff-catcher
Environment=PATH=/home/larsski/.local/bin:/home/larsski/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin
# dontAsk: only the allowlist runs; everything else is denied. Transcripts are
# untrusted text, so the unattended run gets no general shell.
# Three videos a night: three separate runs, each with fresh context. The '-'
# prefix lets the next run go ahead when one fails.
ExecStart=-/home/larsski/.local/bin/claude -p "Run the kb-nightly skill." --model sonnet --permission-mode dontAsk --allowedTools "Skill,Read,Write,Edit,Glob,Grep,Bash(yt-dlp:*),Bash(curl:*),Bash(python3 /home/larsski/Code/bluff-catcher/research/dedup-captions.py:*),Bash(python3 /home/larsski/Code/bluff-catcher/research/kb-queue.py:*),Bash(wc:*),Bash(date:*),Bash(ls:*)"
ExecStart=-/home/larsski/.local/bin/claude -p "Run the kb-nightly skill." --model sonnet --permission-mode dontAsk --allowedTools "Skill,Read,Write,Edit,Glob,Grep,Bash(yt-dlp:*),Bash(curl:*),Bash(python3 /home/larsski/Code/bluff-catcher/research/dedup-captions.py:*),Bash(python3 /home/larsski/Code/bluff-catcher/research/kb-queue.py:*),Bash(wc:*),Bash(date:*),Bash(ls:*)"
ExecStart=-/home/larsski/.local/bin/claude -p "Run the kb-nightly skill." --model sonnet --permission-mode dontAsk --allowedTools "Skill,Read,Write,Edit,Glob,Grep,Bash(yt-dlp:*),Bash(curl:*),Bash(python3 /home/larsski/Code/bluff-catcher/research/dedup-captions.py:*),Bash(python3 /home/larsski/Code/bluff-catcher/research/kb-queue.py:*),Bash(wc:*),Bash(date:*),Bash(ls:*)"
# Then Opus, a different model from the Sonnet extractor, reviews the staging
# area and merges what passes. File tools only: it needs no shell or network.
ExecStart=-/home/larsski/.local/bin/claude -p "Run the kb-autoreview skill." --model opus --permission-mode dontAsk --allowedTools "Skill,Read,Write,Edit,Glob,Grep,Bash(wc:*)"
TimeoutStartSec=3h
# Alert on the desktop when nothing got processed tonight (expired login, a dead
# transcript source, or the queue paused), or when the service itself failed or
# timed out. The runs above ignore their own exit codes, so this is the signal.
ExecStopPost=/bin/sh -c 'd=$(date +%%F); f=research/coaching-transcripts/state.json; if [ "$SERVICE_RESULT" != success ]; then notify-send -u critical "kb-nightly failed" "$SERVICE_RESULT: journalctl --user -u kb-nightly"; elif ! grep -q "$d" "$f"; then notify-send -u critical "kb-nightly: no video tonight" "Check digest.md and journalctl --user -u kb-nightly"; fi'
